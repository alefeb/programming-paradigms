### 4. Автоматические тесты (`test_support_tickets.py`)

```python
import unittest
from support_tickets import (
    validate_ticket,
    priority_key,
    check_sla_violation,
    build_queue,
    status_counts,
    DEFAULT_SLA_LIMITS
)


class TestSupportTickets(unittest.TestCase):

    def test_validate_ticket_success(self):
        """1. Успешная валидация корректной заявки."""
        ticket = {"id": 1, "applicant": "Иван", "priority": "high", "created_at": 10, "status": "open"}
        validated = validate_ticket(ticket)
        self.assertEqual(validated["id"], 1)
        self.assertEqual(validated["created_at"], 10.0)

    def test_invalid_priority_raises_error(self):
        """2. Ошибочный сценарий: недопустимый приоритет."""
        ticket = {"id": 1, "applicant": "Иван", "priority": "urgent", "created_at": 10, "status": "open"}
        with self.assertRaises(ValueError):
            validate_ticket(ticket)

    def test_missing_field_raises_error(self):
        """3. Ошибочный сценарий: отсутствие обязательного поля."""
        ticket = {"id": 1, "priority": "high", "created_at": 10, "status": "open"}
        with self.assertRaises(ValueError):
            validate_ticket(ticket)

    def test_priority_queue_sorting(self):
        """4. Граничный/Нормальный сценарий: сортировка очереди по приоритету и времени."""
        tickets = [
            {"id": 1, "applicant": "А1", "priority": "medium", "created_at": 5, "status": "open"},
            {"id": 2, "applicant": "А2", "priority": "high", "created_at": 10, "status": "open"},
            {"id": 3, "applicant": "А3", "priority": "high", "created_at": 2, "status": "open"},
        ]
        queue = build_queue(tickets)
        # Ожидаемый порядок: ID 3 (high, t=2), ID 2 (high, t=10), ID 1 (medium, t=5)
        self.assertEqual([t["id"] for t in queue], [3, 2, 1])

    def test_sla_violation_check(self):
        """5. Проверка Варианта повышенной сложности (SLA)."""
        ticket = {"id": 1, "applicant": "А1", "priority": "high", "created_at": 0, "status": "open"}
        # Ограничение high = 15 мин. Время 20 -> нарушение
        self.assertTrue(check_sla_violation(ticket, current_time=20.0))
        # Время 10 -> нет нарушения
        self.assertFalse(check_sla_violation(ticket, current_time=10.0))

    def test_source_data_is_not_mutated(self):
        """6. Граничный сценарий: исходный список заявок не должен изменяться."""
        tickets = [{"id": 1, "applicant": "А1", "priority": "high", "created_at": 5, "status": "open"}]
        tickets_copy = [{"id": 1, "applicant": "А1", "priority": "high", "created_at": 5, "status": "open"}]
        build_queue(tickets)
        self.assertEqual(tickets, tickets_copy)


if __name__ == "__main__":
    unittest.main()
