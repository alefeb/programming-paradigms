"""
Модуль обработки заявок технической поддержки.
Лабораторная работа № 3. Вариант № 9 (Заявки поддержки).
"""

PRIORITY_MAP = {
    "high": 1,
    "medium": 2,
    "low": 3
}

DEFAULT_SLA_LIMITS = {
    "high": 15,      # 15 минут
    "medium": 60,    # 60 минут
    "low": 240       # 240 минут
}


def validate_ticket(ticket: dict) -> dict:
    """Возвращает проверенную копию записи заявки."""
    if not isinstance(ticket, dict):
        raise TypeError("Заявка должна быть словарём")

    required_fields = {"id", "applicant", "priority", "created_at", "status"}
    missing = required_fields - ticket.keys()
    if missing:
        raise ValueError(f"Отсутствуют обязательные поля: {sorted(missing)}")

    ticket_id = ticket["id"]
    if isinstance(ticket_id, bool) or not isinstance(ticket_id, int) or ticket_id <= 0:
        raise ValueError("Идентификатор заявки должен быть положительным целым числом")

    applicant = ticket["applicant"]
    if not isinstance(applicant, str) or not applicant.strip():
        raise ValueError("Имя заявителя не может быть пустым")

    priority = ticket["priority"]
    if priority not in PRIORITY_MAP:
        raise ValueError(f"Недопустимый приоритет: {priority}")

    created_at = ticket["created_at"]
    if isinstance(created_at, bool) or not isinstance(created_at, (int, float)) or created_at < 0:
        raise ValueError("Время создания должно быть неотрицательным числом")

    valid_statuses = {"open", "in_progress", "resolved", "closed"}
    status = ticket["status"]
    if status not in valid_statuses:
        raise ValueError(f"Недопустимый статус: {status}")

    return {
        "id": ticket_id,
        "applicant": applicant.strip(),
        "priority": priority,
        "created_at": float(created_at),
        "status": status
    }


def priority_key(ticket: dict) -> tuple:
    """Формирует ключ для сортировки: сначала наивысший приоритет, затем раннее время."""
    valid_ticket = validate_ticket(ticket)
    return (PRIORITY_MAP[valid_ticket["priority"]], valid_ticket["created_at"])


def check_sla_violation(ticket: dict, current_time: float, sla_limits: dict = None) -> bool:
    """Проверяет, превышено ли время ожидания SLA для нерешённой заявки."""
    if sla_limits is None:
        sla_limits = DEFAULT_SLA_LIMITS

    valid_ticket = validate_ticket(ticket)
    if isinstance(current_time, bool) or not isinstance(current_time, (int, float)) or current_time < 0:
        raise ValueError("Текущее время должно быть неотрицательным числом")

    if valid_ticket["status"] in {"resolved", "closed"}:
        return False

    wait_time = current_time - valid_ticket["created_at"]
    limit = sla_limits.get(valid_ticket["priority"], float("inf"))
    return wait_time > limit


def build_queue(tickets: list) -> list:
    """Строит отсортированную очередь открытых и находящихся в работе заявок."""
    if not isinstance(tickets, list):
        raise TypeError("Список заявок должен быть типом list")

    active_tickets = []
    for t in tickets:
        valid_t = validate_ticket(t)
        if valid_t["status"] in {"open", "in_progress"}:
            active_tickets.append(valid_t)

    return sorted(active_tickets, key=priority_key)


def status_counts(tickets: list) -> dict:
    """Возвращает количество заявок по каждому статусу."""
    if not isinstance(tickets, list):
        raise TypeError("Список заявок должен быть типом list")

    counts = {"open": 0, "in_progress": 0, "resolved": 0, "closed": 0}
    for t in tickets:
        valid_t = validate_ticket(t)
        counts[valid_t["status"]] += 1

    return counts


def format_queue_report(queue: list, current_time: float) -> str:
    """Формирует текстовый отчёт о состоянии очереди заявок."""
    lines = ["=== Очередь заявок техподдержки ==="]
    for position, ticket in enumerate(queue, start=1):
        is_sla_violated = check_sla_violation(ticket, current_time)
        sla_status = " [НАРУШЕНИЕ SLA]" if is_sla_violated else ""
        lines.append(
            f"{position}. ID {ticket['id']} ({ticket['applicant']}) | "
            f"Приоритет: {ticket['priority']} | Статус: {ticket['status']}{sla_status}"
        )
    return "\n".join(lines)


def main():
    demo_tickets = [
        {"id": 101, "applicant": "Амина", "priority": "medium", "created_at": 10.0, "status": "open"},
        {"id": 102, "applicant": "Диас", "priority": "high", "created_at": 20.0, "status": "open"},
        {"id": 103, "applicant": "Мира", "priority": "high", "created_at": 5.0, "status": "open"},
        {"id": 104, "applicant": "Арман", "priority": "low", "created_at": 0.0, "status": "resolved"},
    ]

    current_time = 30.0  # текущий момент времени
    queue = build_queue(demo_tickets)
    stats = status_counts(demo_tickets)

    print(format_queue_report(queue, current_time))
    print("\nСтатистика по статусам:")
    for status, count in stats.items():
        print(f" - {status}: {count}")


if __name__ == "__main__":
    main()
